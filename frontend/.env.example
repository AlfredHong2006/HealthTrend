# The FastAPI base URL used by the demo pages, read server-side only (src/lib/config.ts).
#
# Deliberately not prefixed NEXT_PUBLIC_: every demo request (`GET /api/demo`,
# `GET /api/demo/{scenario}`) is issued from a Next.js server component, so this value is read
# per request on the server and never enters the client bundle.
HEALTHTREND_API_URL=http://localhost:8000

# The FastAPI base URL the browser calls directly (src/lib/api/browserClient.ts and
# src/lib/api/accountClient.ts): the public own-data pages -- manual entry and CSV import -- and
# every signed-in /app request (sign-in, measurements, analysis, settings, export, deletion).
# Deliberately public and prefixed NEXT_PUBLIC_ -- unlike the variable above, this one is compiled
# into the client bundle at *build* time, not read per request, so a deployment must supply it when
# the frontend is built, not just when the server starts. It names a URL, not a secret. The backend
# must allow the calling origin via HEALTHTREND_ALLOWED_ORIGINS.
#
# /app signs in with an HttpOnly session cookie set by this API. In production the API must be
# same-site with the frontend (e.g. app.example.com and api.example.com), or browsers will not send
# that cookie -- see docs/deployment.md. Two unrelated provider default domains are not same-site.
NEXT_PUBLIC_HEALTHTREND_API_URL=http://localhost:8000
