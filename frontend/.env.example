# The FastAPI base URL, read server-side only (src/lib/config.ts).
#
# Never prefixed NEXT_PUBLIC_: all requests to the backend happen from Next.js server
# components, never from the browser, so this value is not shipped to the client bundle.
HEALTHTREND_API_URL=http://localhost:8000

# The FastAPI base URL the browser calls directly, from the manual-entry page
# (src/lib/api/browserClient.ts). Deliberately public and prefixed NEXT_PUBLIC_ -- unlike the
# variable above, this one is compiled into the client bundle at *build* time, not read per
# request, so a deployment must supply it when the frontend is built, not just when the server
# starts. It names a URL, not a secret: any visitor's browser reveals it the moment it makes
# the request either way. The backend must allow this origin via HEALTHTREND_ALLOWED_ORIGINS.
NEXT_PUBLIC_HEALTHTREND_API_URL=http://localhost:8000
