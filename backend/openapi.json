{
  "components": {
    "schemas": {
      "AnalysisMetaOut": {
        "description": "Statements about what the numbers mean, so that a client need not assume.",
        "properties": {
          "filtered_not_smoothed": {
            "default": true,
            "description": "The trajectory is the online estimate: each point reflects only the data available at that instant, so it never changes retroactively (ADR-0005).",
            "title": "Filtered Not Smoothed",
            "type": "boolean"
          },
          "interval_describes": {
            "const": "latent_weight",
            "default": "latent_weight",
            "description": "Intervals describe the underlying weight, not what a scale would read. The latter is wider by the measurement variance and answers a different question.",
            "title": "Interval Describes",
            "type": "string"
          },
          "source": {
            "description": "Where the observations came from. demo: generated by this API, synthetic by construction. submitted: provided by the caller; the server cannot know their provenance and makes no claim about it.",
            "enum": [
              "submitted",
              "demo"
            ],
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "source"
        ],
        "title": "AnalysisMetaOut",
        "type": "object"
      },
      "AnalysisRequest": {
        "additionalProperties": false,
        "description": "A series of weigh-ins to analyse.",
        "properties": {
          "forecast_from": {
            "default": "now",
            "description": "The value now measures horizons from the current instant, so a stale series carries the extra elapsed uncertainty. The value last_observation measures them from the final weigh-in.",
            "enum": [
              "now",
              "last_observation"
            ],
            "title": "Forecast From",
            "type": "string"
          },
          "observations": {
            "description": "Weigh-ins in any order; they are sorted chronologically on ingestion.",
            "items": {
              "$ref": "#/components/schemas/ObservationIn"
            },
            "maxItems": 10000,
            "minItems": 1,
            "title": "Observations",
            "type": "array"
          }
        },
        "required": [
          "observations"
        ],
        "title": "AnalysisRequest",
        "type": "object"
      },
      "AnalysisResponse": {
        "description": "Everything the analysis produces from a series of weigh-ins.",
        "properties": {
          "current": {
            "$ref": "#/components/schemas/CurrentEstimateOut"
          },
          "forecast": {
            "$ref": "#/components/schemas/ForecastOut"
          },
          "meta": {
            "$ref": "#/components/schemas/AnalysisMetaOut"
          },
          "n_obs": {
            "title": "N Obs",
            "type": "integer"
          },
          "observations": {
            "items": {
              "$ref": "#/components/schemas/ObservationOut"
            },
            "title": "Observations",
            "type": "array"
          },
          "params": {
            "$ref": "#/components/schemas/ModelParamsOut"
          },
          "span_days": {
            "title": "Span Days",
            "type": "number"
          },
          "trajectory": {
            "items": {
              "$ref": "#/components/schemas/TrajectoryPointOut"
            },
            "title": "Trajectory",
            "type": "array"
          }
        },
        "required": [
          "n_obs",
          "span_days",
          "params",
          "observations",
          "trajectory",
          "current",
          "forecast",
          "meta"
        ],
        "title": "AnalysisResponse",
        "type": "object"
      },
      "CurrentEstimateOut": {
        "description": "The estimate as of the last observation: weight, uncertainty and weekly rate.",
        "properties": {
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "w_kg": {
            "title": "W Kg",
            "type": "number"
          },
          "w_lower95": {
            "title": "W Lower95",
            "type": "number"
          },
          "w_sd": {
            "title": "W Sd",
            "type": "number"
          },
          "w_upper95": {
            "title": "W Upper95",
            "type": "number"
          },
          "weekly_rate_kg": {
            "title": "Weekly Rate Kg",
            "type": "number"
          },
          "weekly_rate_sd_kg": {
            "title": "Weekly Rate Sd Kg",
            "type": "number"
          }
        },
        "required": [
          "timestamp",
          "w_kg",
          "w_sd",
          "w_lower95",
          "w_upper95",
          "weekly_rate_kg",
          "weekly_rate_sd_kg"
        ],
        "title": "CurrentEstimateOut",
        "type": "object"
      },
      "DemoAnalysisResponse": {
        "description": "An analysis of a generated scenario: the standard response plus its provenance.",
        "properties": {
          "current": {
            "$ref": "#/components/schemas/CurrentEstimateOut"
          },
          "forecast": {
            "$ref": "#/components/schemas/ForecastOut"
          },
          "meta": {
            "$ref": "#/components/schemas/AnalysisMetaOut"
          },
          "n_obs": {
            "title": "N Obs",
            "type": "integer"
          },
          "observations": {
            "items": {
              "$ref": "#/components/schemas/ObservationOut"
            },
            "title": "Observations",
            "type": "array"
          },
          "params": {
            "$ref": "#/components/schemas/ModelParamsOut"
          },
          "scenario": {
            "$ref": "#/components/schemas/DemoScenarioOut"
          },
          "span_days": {
            "title": "Span Days",
            "type": "number"
          },
          "trajectory": {
            "items": {
              "$ref": "#/components/schemas/TrajectoryPointOut"
            },
            "title": "Trajectory",
            "type": "array"
          }
        },
        "required": [
          "n_obs",
          "span_days",
          "params",
          "observations",
          "trajectory",
          "current",
          "forecast",
          "meta",
          "scenario"
        ],
        "title": "DemoAnalysisResponse",
        "type": "object"
      },
      "DemoCatalogueResponse": {
        "description": "The list of scenarios available to try.",
        "properties": {
          "scenarios": {
            "items": {
              "$ref": "#/components/schemas/DemoScenarioOut"
            },
            "title": "Scenarios",
            "type": "array"
          },
          "synthetic": {
            "const": true,
            "default": true,
            "description": "Every scenario here is generated. None of it is measured health data.",
            "title": "Synthetic",
            "type": "boolean"
          }
        },
        "required": [
          "scenarios"
        ],
        "title": "DemoCatalogueResponse",
        "type": "object"
      },
      "DemoScenarioOut": {
        "description": "What a demo scenario is, and exactly what generated it.",
        "properties": {
          "description": {
            "title": "Description",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "label": {
            "description": "Provenance label. Always identifies the data as synthetic.",
            "title": "Label",
            "type": "string"
          },
          "parameters": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ]
            },
            "description": "The generator arguments, published so the series can be reproduced.",
            "title": "Parameters",
            "type": "object"
          },
          "seed": {
            "title": "Seed",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "label",
          "seed",
          "parameters"
        ],
        "title": "DemoScenarioOut",
        "type": "object"
      },
      "ErrorBody": {
        "description": "The contents of an error response.",
        "properties": {
          "code": {
            "description": "Stable machine-readable error identifier.",
            "title": "Code",
            "type": "string"
          },
          "details": {
            "description": "Field-level problems, present only for request-validation failures.",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "title": "Details",
            "type": "array"
          },
          "message": {
            "description": "Fixed human-readable explanation.",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorDetail": {
        "description": "One field-level validation problem.",
        "properties": {
          "code": {
            "description": "Stable identifier for the kind of validation failure.",
            "title": "Code",
            "type": "string"
          },
          "location": {
            "description": "Dotted path to the offending field, using positions for list indices.",
            "title": "Location",
            "type": "string"
          },
          "message": {
            "description": "Fixed explanation. Never contains a submitted value.",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "location",
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "The envelope returned for every non-2xx response.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "ForecastOut": {
        "description": "The forecast, and enough context to label it honestly.\n\nThree quantities matter here and all three are published. ``origin_timestamp`` is what\nthe horizons are measured from; ``last_observation_timestamp`` is the most recent real\nmeasurement; ``lead_days`` is the gap between them. A client that renders \"30-day\nforecast\" without knowing the lead cannot tell the user whether that means 30 days from\ntheir last weigh-in or 30 days from today (ADR-0005).",
        "properties": {
          "horizons": {
            "items": {
              "$ref": "#/components/schemas/ForecastPointOut"
            },
            "title": "Horizons",
            "type": "array"
          },
          "includes_observation_noise": {
            "title": "Includes Observation Noise",
            "type": "boolean"
          },
          "last_observation_timestamp": {
            "format": "date-time",
            "title": "Last Observation Timestamp",
            "type": "string"
          },
          "lead_days": {
            "title": "Lead Days",
            "type": "number"
          },
          "origin_timestamp": {
            "format": "date-time",
            "title": "Origin Timestamp",
            "type": "string"
          },
          "path": {
            "items": {
              "$ref": "#/components/schemas/ForecastPointOut"
            },
            "title": "Path",
            "type": "array"
          }
        },
        "required": [
          "origin_timestamp",
          "last_observation_timestamp",
          "lead_days",
          "includes_observation_noise",
          "horizons",
          "path"
        ],
        "title": "ForecastOut",
        "type": "object"
      },
      "ForecastPointOut": {
        "description": "The predictive distribution of latent weight at one horizon.",
        "properties": {
          "horizon_days": {
            "title": "Horizon Days",
            "type": "number"
          },
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "w_kg": {
            "title": "W Kg",
            "type": "number"
          },
          "w_lower95": {
            "title": "W Lower95",
            "type": "number"
          },
          "w_sd": {
            "title": "W Sd",
            "type": "number"
          },
          "w_upper95": {
            "title": "W Upper95",
            "type": "number"
          }
        },
        "required": [
          "timestamp",
          "horizon_days",
          "w_kg",
          "w_sd",
          "w_lower95",
          "w_upper95"
        ],
        "title": "ForecastPointOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Confirmation that the service is running.\n\nDeliberately contains no data, no timestamp and no dependency check: the point of a\nliveness endpoint is that it cannot fail for an interesting reason.",
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "description": "The API version.",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ModelParamsOut": {
        "description": "The model parameters used, echoed for transparency.\n\nThese are documented priors, not values fitted to this or any data. They are published\nso that a caller can see what produced the numbers, not so that they can be tuned.",
        "properties": {
          "initial_weekly_rate_spread_kg_per_week": {
            "title": "Initial Weekly Rate Spread Kg Per Week",
            "type": "number"
          },
          "sigma_accel": {
            "title": "Sigma Accel",
            "type": "number"
          },
          "sigma_obs_kg": {
            "title": "Sigma Obs Kg",
            "type": "number"
          },
          "sigma_v0": {
            "title": "Sigma V0",
            "type": "number"
          },
          "weekly_rate_drift_kg_per_week": {
            "title": "Weekly Rate Drift Kg Per Week",
            "type": "number"
          }
        },
        "required": [
          "sigma_obs_kg",
          "sigma_accel",
          "sigma_v0",
          "weekly_rate_drift_kg_per_week",
          "initial_weekly_rate_spread_kg_per_week"
        ],
        "title": "ModelParamsOut",
        "type": "object"
      },
      "ObservationIn": {
        "additionalProperties": false,
        "description": "One submitted weight measurement.",
        "properties": {
          "timestamp": {
            "description": "ISO-8601 instant of the weigh-in. Must carry a timezone offset, and must not be so late that a 90-day forecast from it is unrepresentable.",
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "unit": {
            "default": "kg",
            "description": "Unit of the weight field.",
            "enum": [
              "kg",
              "lb"
            ],
            "title": "Unit",
            "type": "string"
          },
          "weight": {
            "description": "The measured value, in the unit given by the unit field.",
            "exclusiveMinimum": 0.0,
            "title": "Weight",
            "type": "number"
          }
        },
        "required": [
          "timestamp",
          "weight"
        ],
        "title": "ObservationIn",
        "type": "object"
      },
      "ObservationOut": {
        "description": "One normalised observation, in kilograms and UTC.",
        "properties": {
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "weight_kg": {
            "title": "Weight Kg",
            "type": "number"
          }
        },
        "required": [
          "timestamp",
          "weight_kg"
        ],
        "title": "ObservationOut",
        "type": "object"
      },
      "TrajectoryPointOut": {
        "description": "One point on the estimated latent-weight path.",
        "properties": {
          "timestamp": {
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          },
          "w_kg": {
            "title": "W Kg",
            "type": "number"
          },
          "w_lower95": {
            "title": "W Lower95",
            "type": "number"
          },
          "w_sd": {
            "title": "W Sd",
            "type": "number"
          },
          "w_upper95": {
            "title": "W Upper95",
            "type": "number"
          }
        },
        "required": [
          "timestamp",
          "w_kg",
          "w_sd",
          "w_lower95",
          "w_upper95"
        ],
        "title": "TrajectoryPointOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Estimates the underlying weight trajectory behind noisy scale readings, quantifies how\nuncertain that estimate is, and forecasts where it is heading.\n\nIntervals describe the latent weight rather than a future scale reading, and the trajectory\nis the online (filtered) estimate, so no point on it changes retroactively.\n\nNot a medical device: this estimates and forecasts a measurement trend. It does not\ndiagnose, treat or prescribe.",
    "summary": "Probabilistic weight-trend estimation and forecasting.",
    "title": "HealthTrend",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/analyse": {
      "post": {
        "description": "Analyse a submitted series of weigh-ins.\n\nReturns the filtered latent-weight trajectory with 95% intervals, the current estimate\nand weekly rate, and the 7-, 30- and 90-day forecasts with the band between them.",
        "operationId": "analyse_api_analyse_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The request was rejected."
          }
        },
        "summary": "Estimate the latent weight trend and forecast it",
        "tags": [
          "analysis"
        ]
      }
    },
    "/api/demo": {
      "get": {
        "description": "List every available demo scenario. All of them are generated, none measured.",
        "operationId": "demo_catalogue_api_demo_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoCatalogueResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List the synthetic demo scenarios",
        "tags": [
          "demo"
        ]
      }
    },
    "/api/demo/{scenario}": {
      "get": {
        "description": "Generate the named scenario, ending just before now, and analyse it.\n\nThe response is the same shape as ``POST /api/analyse`` with the scenario's provenance\nadded, so a client needs only one renderer.",
        "operationId": "demo_analysis_api_demo__scenario__get",
        "parameters": [
          {
            "in": "path",
            "name": "scenario",
            "required": true,
            "schema": {
              "title": "Scenario",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoAnalysisResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "No such demo scenario."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Analyse a synthetic demo scenario",
        "tags": [
          "demo"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Report that the service is up.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness check",
        "tags": [
          "service"
        ]
      }
    }
  }
}
