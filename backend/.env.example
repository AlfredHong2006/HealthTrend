# HealthTrend backend configuration -- names and placeholders only. Never commit real values.
#
# Read from the process environment when the server starts (app/config.py). The server refuses
# to start if a required value is missing or contradictory; that is deliberate, not a bug to work
# around. Nothing here is logged or placed in an error message.
#
# Production: set these in the hosting provider's environment settings, not in a file.
# Local development: export them in your shell (uv does not load .env files by itself).

# --- CORS -----------------------------------------------------------------------------------
# Comma-separated browser origins allowed to call this API directly. Empty means none (fail
# closed); "*" is refused. In production list the /app frontend origin and, while it is still
# served, the public frontend origin whose own-data page calls POST /api/analyse from the browser.
HEALTHTREND_ALLOWED_ORIGINS=http://localhost:3000

# --- Database (required) ----------------------------------------------------------------------
# SQLAlchemy URL. Must name the psycopg 3 driver: postgresql+psycopg://, not postgresql://.
# Managed Postgres such as Neon also needs ?sslmode=require.
HEALTHTREND_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# --- Sign-in secret (required) ------------------------------------------------------------------
# At least 32 characters. Keys the HMAC that makes stored sign-in codes useless without it.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it invalidates every sign-in code already issued (not existing sessions).
HEALTHTREND_AUTH_SECRET=replace-with-at-least-32-random-characters

# --- Session cookie ------------------------------------------------------------------------------
# true (the default) marks the session cookie Secure: HTTPS only. Must be true in production.
# Only a local plain-HTTP setup sets false.
HEALTHTREND_COOKIE_SECURE=true

# --- Mailer --------------------------------------------------------------------------------------
# smtp (the default) or console. console prints sign-in codes to stdout and is refused whenever
# HEALTHTREND_COOKIE_SECURE is true -- i.e. it is for local plain-HTTP development only.
HEALTHTREND_MAILER=smtp

# SMTP, required when HEALTHTREND_MAILER=smtp. Always TLS: implicit on port 465, STARTTLS on any
# other port. Any SMTP provider works; nothing in the code is provider-specific.
HEALTHTREND_SMTP_HOST=smtp.example.com
HEALTHTREND_SMTP_PORT=587
HEALTHTREND_SMTP_USER=replace-with-smtp-username
HEALTHTREND_SMTP_PASSWORD=replace-with-smtp-password
HEALTHTREND_SMTP_FROM=HealthTrend <sign-in@example.com>

# --- Closed beta ---------------------------------------------------------------------------------
# Comma-separated addresses allowed to sign in. Unset or empty means anyone may sign in.
# Removing an address also ends that account's existing sessions on its next request.
HEALTHTREND_BETA_ALLOWED_EMAILS=tester-one@example.com,tester-two@example.com

# --- Local development only (do not use in production) --------------------------------------------
# HEALTHTREND_COOKIE_SECURE=false
# HEALTHTREND_MAILER=console
# HEALTHTREND_DATABASE_URL=postgresql+psycopg://healthtrend:healthtrend@localhost:5432/healthtrend
