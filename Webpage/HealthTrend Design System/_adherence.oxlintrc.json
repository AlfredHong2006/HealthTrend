{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/metrics/**",
              "components/prose/**",
              "ui_kits/app/**",
              "ui_kits/method/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Source Serif 4|IBM Plex Sans|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Source Serif 4, IBM Plex Sans, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:neutral|accent|stale|outline)$/]",
        "message": "<Badge> variant must be one of 'neutral' | 'accent' | 'stale' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|iconRight|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, iconRight, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|quiet)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Button> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChartLegend'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|layout|key|ref|className|style|children)$/]",
        "message": "<ChartLegend> doesn't accept that prop. Declared props: items, layout."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChartLegend'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:row|column)$/]",
        "message": "<ChartLegend> layout must be one of 'row' | 'column'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Citation'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|marker|href|key|ref|className|style|children)$/]",
        "message": "<Citation> doesn't accept that prop. Declared props: children, marker, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Equation'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|number|display|key|ref|className|style|children)$/]",
        "message": "<Equation> doesn't accept that prop. Declared props: children, number, display."
      },
      {
        "selector": "JSXOpeningElement[name.name='FigureCaption'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|source|key|ref|className|style|children)$/]",
        "message": "<FigureCaption> doesn't accept that prop. Declared props: label, children, source."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroMetric'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|interval|asOf|align|key|ref|className|style|children)$/]",
        "message": "<HeroMetric> doesn't accept that prop. Declared props: label, value, unit, interval, asOf, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroMetric'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<HeroMetric> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|size|active|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, size, active, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|label|unit|placeholder|width|numeric|hint|align|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: value, onChange, label, unit, placeholder, width, numeric, hint, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<Input> align must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MarginNote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|marker|side|key|ref|className|style|children)$/]",
        "message": "<MarginNote> doesn't accept that prop. Declared props: children, marker, side."
      },
      {
        "selector": "JSXOpeningElement[name.name='MarginNote'] > JSXAttribute[name.name='side'] > Literal[value!=/^(?:right|left)$/]",
        "message": "<MarginNote> side must be one of 'right' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MeasurementRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:date|reading|trend|residual|key|ref|className|style|children)$/]",
        "message": "<MeasurementRow> doesn't accept that prop. Declared props: date, reading, trend, residual."
      },
      {
        "selector": "JSXOpeningElement[name.name='Prose'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|width|align|style|key|ref|className|style|children)$/]",
        "message": "<Prose> doesn't accept that prop. Declared props: children, size, width, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Prose'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lede|body|sm)$/]",
        "message": "<Prose> size must be one of 'lede' | 'body' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Prose'] > JSXAttribute[name.name='width'] > Literal[value!=/^(?:prose|narrow|wide)$/]",
        "message": "<Prose> width must be one of 'prose' | 'narrow' | 'wide'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Prose'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:start|center)$/]",
        "message": "<Prose> align must be one of 'start' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Qualifier'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|icon|tone|style|key|ref|className|style|children)$/]",
        "message": "<Qualifier> doesn't accept that prop. Declared props: children, icon, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Qualifier'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|stale|accent)$/]",
        "message": "<Qualifier> tone must be one of 'default' | 'stale' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RangeStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:series|from|to|height|ticks|onChange|key|ref|className|style|children)$/]",
        "message": "<RangeStrip> doesn't accept that prop. Declared props: series, from, to, height, ticks, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='RawReading'] > JSXAttribute > JSXIdentifier[name!=/^(?:date|value|unit|delta|muted|key|ref|className|style|children)$/]",
        "message": "<RawReading> doesn't accept that prop. Declared props: date, value, unit, delta, muted."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|children|level|note|rule|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: eyebrow, children, level, note, rule."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SegmentedOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sparkline'] > JSXAttribute > JSXIdentifier[name!=/^(?:trend|width|height|showBand|strokeWidth|key|ref|className|style|children)$/]",
        "message": "<Sparkline> doesn't accept that prop. Declared props: trend, width, height, showBand, strokeWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='SupportingMetric'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|qualifier|emphasis|key|ref|className|style|children)$/]",
        "message": "<SupportingMetric> doesn't accept that prop. Declared props: label, value, unit, qualifier, emphasis."
